{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@cxx/app-shell/*": ["packages/app-shell/src/*"],
      "@cxx/app-shell": ["packages/app-shell/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.vue",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.vue",
    "desktop/**/*.ts"
  ]
}
